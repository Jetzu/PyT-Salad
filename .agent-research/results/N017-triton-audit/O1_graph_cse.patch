--- a/salad_torch/modules/fast.py
+++ b/salad_torch/modules/fast.py
@@ N017/O1: install inductor's FX-level CSE before compiling the core.
@@
@@ Insert in FastDenoiser.__init__, next to the other process-global inductor
@@ knobs (`_ind.aggressive_fusion`), BEFORE `torch.compile` is called.
@@
     import torch._inductor.config as _ind
     _ind.aggressive_fusion = bool(p.get("aggressive_fusion")) and opt.AGGRESSIVE_FUSION
+    # N017/O1. Inductor's inference pipeline has no CSE pass: `joint_graph_passes`
+    # runs remove_noop_ops, the pattern matcher and constant folding, and that is
+    # all. The denoiser rebuilds the SAME Gram-Schmidt frame 61 times per forward
+    # (`aa_frames_t` -> `rot_from_two_vectors`, 4-5 kernel launches each on a
+    # (N, 3) tensor): three times inside every `DiffusionPairFeatures`, again in
+    # `Update`, again in `UpdatePositions`, and `attn_2`'s `prev_pos/sigma` frame
+    # is identical in all six blocks. Running `fx_graph_cse` over the post-dispatch
+    # graph deletes 31 of those, which is -43 triton and -7 bmm launches, i.e.
+    # -2.5 to -2.9 % of a lean step at L=50/100/200.
+    #
+    # BIT-IDENTICAL, not approximately: CSE deletes re-executions of pure ops with
+    # identical arguments, it does not reassociate anything. Verified bitwise on
+    # CPU (deterministic by construction) over all eleven `forward_core` outputs at
+    # L=64 and L=100 - max|d| = 0.0 exactly.
+    #
+    # Do NOT substitute `_ind.freezing = True`. It runs this same CSE and measures
+    # identically (677 kernels, 3.05-3.07 ms), but it ALSO constant-folds the
+    # parameters and runs its own layout passes, and those DO move the numbers:
+    # measured pos 8.8e-06, raw_angles 1.5e-03 on the same CPU control. That is
+    # under the 2e-05 A parity floor, so it would pass `test_model_parity` while
+    # quietly not being fp32-exact - exactly the K014 failure mode.
+    try:
+        from torch._functorch.compile_utils import fx_graph_cse as _cse
+
+        def _cse_pass(graph):
+            graph.owning_module.graph = _cse(graph)
+
+        _ind.joint_custom_post_pass = _cse_pass
+    except (ImportError, AttributeError):
+        # private torch path; a version bump that moves it must degrade to the
+        # plain compile, never fail the denoiser.
+        pass
     opt.BATCH_COND = bool(p.get("batch_cond_pair")) and _ENV_BATCH_COND
