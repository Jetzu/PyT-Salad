--- a/salad_torch/geometry/features.py
+++ b/salad_torch/geometry/features.py
@@ -9,6 +9,7 @@ from torch import Tensor
 from .rigid import Rigid, vec_norm, vec_normalized
 from .frames import aa_frames_t, apply_inverse_t, extract_aa_frames
 from .segment import index_count
+from .. import opt
 
 __all__ = [
     "linear_centers", "gaussian_rbf", "distance_rbf", "distance_one_hot",
@@ -201,14 +202,43 @@ def pair_vector_features(pos: Tensor, neighbours: Tensor, scale: float = 0.1) ->
     """Directions and scaled coordinates of both residues' atoms in frame i.
 
     -> ``(N, K, 12*A)``: ``[dir(2A*3), scale*coord(2A*3)]``.
+
+    N029/O1. The frame-local coordinates are built from the two halves the
+    graph ALREADY contains instead of from one ``(N, K, 2A, 3)`` contraction:
+
+    * the SELF half, ``R_i^T (pos_i - ca_i)``, does not depend on ``k`` at all
+      and is exactly ``aa_frames_t(pos)[2]`` - the tensor every caller of
+      `aa_frames_t` in the same block already holds. It used to be broadcast to
+      ``(N, K, A, 3)`` and pushed through the contraction K times.
+    * the NEIGHBOUR half is bit-for-bit `direction_features`' pre-normalisation
+      ``local``. Writing it as the same expression lets inductor's CSE pass
+      share the two, which removes one ``(100, 3, 3) x (100, 3, K*A)`` bmm per
+      pair block - a cuBLAS launch, the single most expensive unit in this
+      model.
+
+    NOT BIT-EXACT - measured, do not assume otherwise. ``R^T (p - t)`` is still
+    one 3-term contraction per output component, but the self half now comes out
+    of a width-20 GEMM instead of a width-2A*K one, and the two pick different
+    BLAS kernels. Whether they agree is DATA-DEPENDENT: `torch.equal` on eight
+    synthetic shapes and the compiled CPU bitwise control at L=64/100 both say
+    0.0, while the eager model on the parity fixtures differs by up to
+    **1.63e-04 A** on `pos` (multimotif_vp; 9.1e-06 on default_vp). The whole
+    parity suite still passes. So this is a REASSOCIATION, the same class as P5:
+    `fast`-preset only, behind N015's n=160 structural gate, never `exact`.
+    Whoever lands it must flip the default below to False and add a preset key.
     """
-    rot, trans, _ = aa_frames_t(pos)
+    rot, trans, local_self = aa_frames_t(pos)
     n, a, _ = pos.shape
     k = neighbours.shape[1]
-    self_pos = pos[:, None].expand(n, k, a, 3)            # (N, K, A, 3)
     neigh_pos = pos[neighbours]                           # (N, K, A, 3)
-    both = torch.cat([self_pos, neigh_pos], dim=-2)       # (N, K, 2A, 3)
-    local = apply_inverse_t(rot, trans, both, k=2)
+    if opt.PAIRVEC_SHARE:
+        local_neigh = apply_inverse_t(rot, trans, neigh_pos, k=2)  # (N, K, A, 3)
+        local = torch.cat([local_self[:, None].expand(n, k, a, 3),
+                           local_neigh], dim=-2)          # (N, K, 2A, 3)
+    else:
+        both = torch.cat([pos[:, None].expand(n, k, a, 3),
+                          neigh_pos], dim=-2)             # (N, K, 2A, 3)
+        local = apply_inverse_t(rot, trans, both, k=2)
     directions = vec_normalized(local).reshape(n, k, 2 * a * 3)
     coords = (scale * local).reshape(n, k, 2 * a * 3)
     return torch.cat([directions, coords], dim=-1)
diff --git a/salad_torch/opt.py b/salad_torch/opt.py
index bf24d94..9cece2a 100644
--- a/salad_torch/opt.py
+++ b/salad_torch/opt.py
@@ -198,3 +198,20 @@ if MM_MODE is None:
 #: structural validation - see N015's method - which has NOT been run) but no
 #: shipped preset requests it.
 GEMM_TEMPLATES = _flag("SALAD_OPT_GEMMTPL", default=False)
+
+#: N029/O1 - build `pair_vector_features`' frame-local coordinates from the two
+#: halves the graph already holds instead of from one wide contraction.
+#: The self half IS `aa_frames_t(pos)[2]` (k-independent, already materialised)
+#: and the neighbour half IS `direction_features`' pre-normalisation `local`,
+#: so writing them as those expressions lets inductor's CSE share the second
+#: one - which deletes one `(100,3,3)x(100,3,K*A)` bmm per pair block.
+#: `SALAD_OPT_PAIRVEC=0` restores the single wide contraction.
+#:
+#: Worth **-7.3 % of a lean step at L=100** (3.379 -> 3.131 ms, job 907152) and
+#: it passes `test_design_quality --n 160 --preset fast` at 0/160 diverged.
+#: But it is **NOT bit-exact** (up to 1.63e-04 A on multimotif_vp - see
+#: `features.pair_vector_features` and N029 RESULTS.md section 5), so it is a
+#: `fast`-preset candidate and never an `exact` one. The default is left True
+#: here only because that is the arm N029 benchmarked; **flip it to False and
+#: add a `pairvec_share` preset key before landing this anywhere.**
+PAIRVEC_SHARE = _flag("SALAD_OPT_PAIRVEC")
