Bootstrap: docker
From: python:3.11-slim-bookworm

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # build-essential (gcc): triton's runtime JIT-builds a tiny CPython
    # extension (driver.c -> cuda_utils.so) on FIRST kernel launch, even
    # though inductor itself only emits Triton/C++ source text - this bit
    # python:3.11-slim-bookworm's total absence of a C compiler (found the
    # hard way: every torch.compile call failed on H100 with "Failed to find
    # C compiler", not a torch-2.7 issue at all).
    apt-get install -y --no-install-recommends ca-certificates build-essential
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir --upgrade pip
    # Minimal deps actually imported by SALAD_torch's gate tests (numpy, torch only;
    # jax/haiku/biotite/einops/scipy/dm-tree are triad-env leftovers, not used here -
    # verified by AST-scanning salad_torch/tests/scripts before building).
    python3 -m pip install --no-cache-dir numpy==1.26.4
    python3 -m pip install --no-cache-dir torch==2.7.1+cu128 \
        --index-url https://download.pytorch.org/whl/cu128
    python3 -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%labels
    Author lukas.gerstung@tum.de
    Purpose "SALAD_torch N033: torch upgrade evaluation (2.5.1+cu121 -> 2.7.1+cu128)"
    Torch 2.7.1+cu128

%help
    Standalone torch 2.7.1+cu128 environment for evaluating an upgrade away
    from the project's default triad conda env (torch 2.5.1+cu121).
    Do NOT use this for production runs - evaluation only.
